# Zendesk Web Widget key. Public by design (it ships in the page HTML), and a
# default is committed in components/support-widget.tsx — set this only to point
# at a different instance. Set it to an empty string to force the offline
# placeholder panel.
NEXT_PUBLIC_ZENDESK_KEY=

# Zendesk messaging authentication ("Authenticated visitors").
# Admin Center -> Channels -> Messaging -> your widget -> Authentication.
# SECRET — server-side only, never prefix with NEXT_PUBLIC_. Anyone holding it
# can impersonate any end user in your Zendesk instance.
ZENDESK_JWT_KEY_ID=
ZENDESK_JWT_SECRET=

# Durable storage. Vercel Marketplace -> Upstash Redis injects these
# automatically. Without them the app uses an in-memory store, which loses
# writes on serverless instance recycling.
KV_REST_API_URL=
KV_REST_API_TOKEN=
